# =============================================================================
# STUDIO PULSE — ENVIRONMENT VARIABLES TEMPLATE
# =============================================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your real .env file or API keys to a public repository.
# =============================================================================

# Server Configuration
PORT=3001
FRONTEND_URL=http://localhost:5173
ENCRYPTION_SECRET=your_32_character_encryption_secret_here

# Database (Turso LibSQL)
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Authentication (Clerk)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

# YouTube OAuth 2.0 Credentials (Google Cloud Console)
YOUTUBE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_google_client_secret_here
YOUTUBE_REDIRECT_URI=http://localhost:3001/api/platforms/youtube/callback

# Meta (Facebook & Instagram) Graph API
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_CONFIG_ID=your_optional_meta_config_id
META_REDIRECT_URI=http://localhost:3001/api/platforms/meta/callback
META_API_VERSION=v21.0

# Backward Compatibility Meta Keys
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# -----------------------------------------------------------------------------
# Studio AI — Groq Key Pools (Round-Robin Multi-Key Rotation)
# -----------------------------------------------------------------------------
# Chat Engine Pool (dedicated keys for user conversations)
GROQ_CHAT_KEY_1=gsk_your_groq_chat_key_1
GROQ_CHAT_KEY_2=gsk_your_groq_chat_key_2
GROQ_CHAT_KEY_3=gsk_your_groq_chat_key_3
# Add up to GROQ_CHAT_KEY_16 as needed

# Task Engine Pool (dedicated keys for background AI tasks & metadata generation)
GROQ_TASK_KEY_1=gsk_your_groq_task_key_1
GROQ_TASK_KEY_2=gsk_your_groq_task_key_2
GROQ_TASK_KEY_3=gsk_your_groq_task_key_3
# Add up to GROQ_TASK_KEY_16 as needed

# Fallback Groq Pool
GROQ_API_KEY_1=gsk_your_groq_fallback_key_1
GROQ_API_KEY_2=gsk_your_groq_fallback_key_2
# Add up to GROQ_API_KEY_8 as needed

# -----------------------------------------------------------------------------
# Studio AI — Gemini Key Pools (Multimodal Vision & Audio Analysis)
# -----------------------------------------------------------------------------
# Vision & Primary Gemini Pool
GEMINI_API_KEY_1=AIzaSy_your_gemini_api_key_1
GEMINI_API_KEY_2=AIzaSy_your_gemini_api_key_2
# Add up to GEMINI_API_KEY_20 as needed

# Audio Intelligence Pool (Gemini 2.5 Flash audio transcription & classification)
GEMINI_AUDIO_KEY_1=AIzaSy_your_gemini_audio_key_1
GEMINI_AUDIO_KEY_2=AIzaSy_your_gemini_audio_key_2
# Add up to GEMINI_AUDIO_KEY_20 as needed

# Viral Clips Pool
GEMINI_CLIP_KEY_1=AIzaSy_your_gemini_clip_key_1
GEMINI_CLIP_KEY_2=AIzaSy_your_gemini_clip_key_2
# Add up to GEMINI_CLIP_KEY_20 as needed

# Editor & Backup Pools
GEMINI_EDITOR_KEY_1=AIzaSy_your_gemini_editor_key_1
GEMINI_BACKUP_KEY_1=AIzaSy_your_gemini_backup_key_1
